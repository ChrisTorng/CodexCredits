{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexCredits",
  "version": "0.1.0",
  "identifier": "com.christorng.codexcredits",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodexCredits",
        "width": 980,
        "height": 720,
        "minWidth": 460,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
