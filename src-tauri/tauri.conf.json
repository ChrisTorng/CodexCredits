{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexCredits",
  "version": "2.0.12",
  "identifier": "com.christorng.codexcredits",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Credits",
        "width": 430,
        "height": 760,
        "minWidth": 340,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/install-hooks.nsh"
      }
    }
  }
}
